# ============================================================
# content-extractor configuration
# Installed to /etc/content-extractor/config.env
# Every value can also be given as an environment variable.
# Values are literal - no quotes needed, and a value may contain spaces.
# Restart after editing:  systemctl restart content-extractor
# ============================================================

# --- n8n Content Extractor API (required) -------------------
N8N_BASE_URL=https://n8n.3rfan.ir/webhook
N8N_API_KEY=change-me

# Must be unique per worker. Defaults to the machine's hostname.
NODE_NAME=vps-extractor-1

# --- throughput ---------------------------------------------
BATCH_SIZE=60          # URLs claimed per cycle (1-500)
THREADS=24             # parallel downloads (1-MAX_THREADS)
MAX_THREADS=64         # hard ceiling for the thread pool

# --- politeness / fetching ----------------------------------
PER_DOMAIN_DELAY=1.0   # min seconds between two requests to the same host
CONNECT_TIMEOUT=10
READ_TIMEOUT=25
MAX_PAGE_BYTES=3000000
HTTP2=true
VERIFY_TLS=true
# PROXY_URL=http://user:pass@proxy.example.com:3128
# USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# --- per-domain circuit breaker -----------------------------
# After this many consecutive blocks (403/429/503...), stop asking that host
# for DOMAIN_COOLOFF_SECONDS. URLs on a cooling host are left claimed and n8n
# requeues them, so nothing is marked failed just because one site pushed back.
DOMAIN_FAILURE_THRESHOLD=5
DOMAIN_COOLOFF_SECONDS=900

# --- headless-browser fallback (optional) -------------------
# Retries pages that need JavaScript in a real Chromium. Slow (serial), so it
# only runs for pages plain HTTP could not read. Needs --with-browser install.
RENDER_FALLBACK=false
RENDER_TIMEOUT=30

# --- content rules (keep in sync with the n8n workflow) -----
MIN_CONTENT_CHARS=150
MAX_CONTENT_CHARS=10000
STRIP_PUNCTUATION=true   # true = same cleaning as the original n8n extractor

# --- loop behaviour -----------------------------------------
IDLE_SLEEP_SECONDS=30
MAX_EMPTY_CYCLES=0       # 0 = keep polling forever
MAX_HOURS=0              # 0 = run forever
HEARTBEAT_SECONDS=60
AUTOSTART=true           # start extracting as soon as the service starts

# --- control panel ------------------------------------------
# 127.0.0.1 is the safe default: reach it with an SSH tunnel
#   ssh -N -L 8787:127.0.0.1:8787 user@your-server
# Set 0.0.0.0 only if you want it reachable from the internet.
PANEL_HOST=127.0.0.1
PANEL_PORT=8787
PANEL_USER=admin
PANEL_PASSWORD=

LOG_LEVEL=INFO
